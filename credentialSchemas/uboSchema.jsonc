// Below is an example credential schema for issuing a Ubo attestation credential.
// It contains the following data:
//    - name
//    - ubo Id
//    - DOB
//    - company Id (registration number)
//    - ownership percentage
//    - jurisdiction
//    - status
//    - currently only DOB, companyId and jurisdiction are SD
{
  "issuerKey": {
    "type": "jwk",
    "jwk": {
      "kty": "OKP",
      "d": "AZNSeOgzDYq1feMCzA49vXVHh2pH0Li8KgCrYnWR4T4",
      "crv": "Ed25519",
      "kid": "EJAaRtUjY8pvhcC6Wd-ywqhZvgR3z6MqUIcf9DrD60E",
      "x": "qo0ErUpaI6WalUW6G3u7ez94R9sLZd-r1mSsS0uFeWs"
    }
  },
  "credentialConfigurationId": "UboAttestationCredential_jwt_vc_json",
  "credentialData": {
    "@context": [
      "https://www.w3.org/ns/credentials/v2"
    ],
    "id": "",
    "type": [
      "VerifiableCredential",
      "UboAttestationCredential"
    ],
    "name": "UBO Attestation Credential",
    "description": "Credential confirming the verified Ultimate Beneficial Owner of a legal entity. This is an individual who ultimately owns or controls the entity",
    "issuer": {
      "type": [
        "Profile"
      ],
      "name": "Australian Transaction Reports and Analysis Centre",
      "url": "https://www.austrac.gov.au/business/core-guidance/customer-identification-and-verification/beneficial-owners",
      "image": "https://www.austrac.gov.au/themes/custom/austrac/logo.svg",
      "background_color": "#C6C5B9",
      "text_color": "#FFFFFF"
    },
    "credentialSubject": {
      "name": "Mr Wallet",
      "uboID": "12345678",
      "DOB": "19/12/96",
      "companyId": "ACN123456789",
      "ownershipPercentage": 60,
      "jurisdiction": "AU",
      "status": "active"
    }
  },
  "mapping": {
    "id": "<uuid>",
    "issuer": {
      "id": "<issuerDid>"
    },
    "credentialSubject": {
      "id": "<subjectDid>"
    },
    "validFrom": "<timestamp>",
    "valid": "<timestamp-in:365d>"
  },
  "selectiveDisclosure": {
    "fields": {
      "credentialSubject": {
        "sd": false,
        "children": {
          "fields": {
            "DOB": {
              "sd": true
            },
            "companyId": {
              "sd": true
            },
            "jurisdiction": {
              "sd": true
            }
          }
        }
      }
    }
  },
  "issuerDid": "did:jwk:eyJrdHkiOiJPS1AiLCJjcnYiOiJFZDI1NTE5Iiwia2lkIjoiRUpBYVJ0VWpZOHB2aGNDNldkLXl3cWhadmdSM3o2TXFVSWNmOURyRDYwRSIsIngiOiJxbzBFclVwYUk2V2FsVVc2RzN1N2V6OTRSOXNMWmQtcjFtU3NTMHVGZVdzIn0"
}
