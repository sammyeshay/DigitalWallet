// Below is an example credential schema for issuing a Corporate Registration credential.
// It contains the following data:
//    - company name
//    - registration number
//    - jurisdiction
//    - incorporation date
//    - status
//    - registered address
//    - currently only jurisidction, incorporation date and address are SD
{
  "issuerKey": {
    "type": "jwk",
    "jwk": {
      "kty": "OKP",
      "d": "AZNSeOgzDYq1feMCzA49vXVHh2pH0Li8KgCrYnWR4T4",
      "crv": "Ed25519",
      "kid": "EJAaRtUjY8pvhcC6Wd-ywqhZvgR3z6MqUIcf9DrD60E",
      "x": "qo0ErUpaI6WalUW6G3u7ez94R9sLZd-r1mSsS0uFeWs"
    }
  },
  "credentialConfigurationId": "CorporateRegistrationCredential_jwt_vc_json",
  "credentialData": {
    "@context": [
      "https://www.w3.org/ns/credentials/v2"
    ],
    "id": "",
    "type": [
      "VerifiableCredential",
      "CorporateRegistrationCredential"
    ],
    "name": "Corporate Registration Credential",
    "description": "Credential proving that a company is officially registered with the relevant corporate registry.",
    "issuer": {
      "type": [
        "Profile"
      ],
      "name": "Australian Securities & Investments Commission",
      "url": "https://www.asic.gov.au/for-business-and-companies/companies/register-a-company/",
      "image": "https://download.asic.gov.au/asic-nextgen/img/asic-logo.svg",
      "background_color": "#FDFDFF",
      "text_color": "#FFFFFF"
    },
    "credentialSubject": {
      "companyName": "Mr Wallet Pty Ltd",
      "registrationNumber": "ACN123456789",
      "jurisdiction": "AU",
      "incorporationDate": "2015-06-01",
      "status": "active",
      "registeredAddress": "123 Fox St, Sydney, AU"
    }
  },
  "mapping": {
    "id": "<uuid>",
    "issuer": {
      "id": "<issuerDid>"
    },
    "credentialSubject": {
      "id": "<subjectDid>"
    },
    "validFrom": "<timestamp>",
    "valid": "<timestamp-in:365d>"
  },
  "selectiveDisclosure": {
    "fields": {
      "credentialSubject": {
        "sd": false,
        "children": {
          "fields": {
            "jurisdiction": {
              "sd": true
            },
            "incorporationDate": {
              "sd": true
            },
            "registeredAddress": {
              "sd": true
            }
          }
        }
      }
    }
  },
  "issuerDid": "did:jwk:eyJrdHkiOiJPS1AiLCJjcnYiOiJFZDI1NTE5Iiwia2lkIjoiRUpBYVJ0VWpZOHB2aGNDNldkLXl3cWhadmdSM3o2TXFVSWNmOURyRDYwRSIsIngiOiJxbzBFclVwYUk2V2FsVVc2RzN1N2V6OTRSOXNMWmQtcjFtU3NTMHVGZVdzIn0"
}
